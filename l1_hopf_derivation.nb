     RowBox[{"3", " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[Omega]", "2"]}], "+", 
     RowBox[{"3", " ", 
      SuperscriptBox["\[Omega]", "3"]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox["\[Omega]", "4"]}], "+", 
     SuperscriptBox["\[Omega]", "5"]}], 
