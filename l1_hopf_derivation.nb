  3.9998404598525696`*^9, 3.9999196267274127`*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"9c7a1974-264e-4e3e-acb0-c740223cd702"]
}, Open  ]],

Cell["\<\
The adjoint eigenvector: A^T pv = -i \[Omega] pv with <pv, q> = conj(pv).q = \
1. We compute pb = conj(pv) instead, which satisfies A^T pb = i \[Omega] pb \
and pb.q = 1; then <pv, x> = pb.x for every x. Rows 2-4 and the normalisation \
determine pb; row 1 is checked afterwards.\
\>", "Text",
 CellChangeTimes->{{3.999840363408392*^9, 
  3.9998403676618166`*^9}},ExpressionUUID->"ac5d7fd0-3a2b-405b-80d2-\
7305e2248439"],

Cell["pbVars = {u1, u2, u3, u4};", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"2b5017b4-4722-4497-a249-78fdc2da4e39"],

Cell["\<\
eqs = Thread[(Transpose[AH] - I \[Omega] IdentityMatrix[4]) . pbVars == 0];\
\>", "Input",
 CellChangeTimes->{3.9998403772296705`*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"cbf871c1-f8b2-448b-aae9-ae92c5e90fee"],

Cell["\<\
pb = Together[pbVars /. First[Solve[Append[Rest[eqs], pbVars . q == 1], \
pbVars]]];\
\>", "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"18512d3b-0f47-452d-98fe-5b79d0994345"],

Cell[CellGroupData[{

Cell[BoxData["pb"], "Input",
 CellChangeTimes->{{3.9998437897498603`*^9, 3.9998437899220457`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"1e18e458-5d1c-4eaf-9eec-a66ee12f0119"],

