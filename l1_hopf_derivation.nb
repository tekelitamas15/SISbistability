Cell["\<\
The formula of the draft, with s = \[Omega]^2 and Sqrt[s] = \[Omega] \
(\[Omega] > 0):\
\>", "Text",
 CellChangeTimes->{{3.9998404160475087`*^9, 
  3.9998404196705775`*^9}},ExpressionUUID->"64bbf103-922a-48ae-a52e-\
c4edccefa41e"],

Cell["P4[s_] := s^4 + 7 s^3 + 39 s^2 + 85 s + 100;", "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"ab7eb7fa-5c45-4b54-9f25-a247b0a6d0ba"],

Cell["P5[s_] := s^5 + 9 s^4 + 18 s^3 + 11 s^2 - 9 s + 6;", "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"d54aad17-4b89-4d6b-93df-df3f96d96439"],

Cell["\<\
P6[s_] := 16 s^6 + 108 s^5 + 441 s^4 + 950 s^3 + 1245 s^2 + 600 s + 100;\
\>", "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"4db7f4b7-bd2e-445e-9603-3029ce8a0db0"],

Cell["\<\
gg[s_] := 4 s^6 - 15 s^5 - 117 s^4 - 537 s^3 - 975 s^2 - 540 s - 100;\
\>", "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"44a663cb-8984-41a6-a4f1-911941fb311e"],

Cell["\<\
l1paper[s_, \[Omega]_] := (s + 1) (s^2 + 3 s + 6) P5[s]^2 gg[s]/(2 \[Omega] \
(s - 3)^4 P4[s] P6[s]);\
\>", "Input",
 CellChangeTimes->{{3.9998404217282476`*^9, 3.9998404240391517`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"67fa8a35-17f5-43a7-a057-398a215c72c3"],

Cell[CellGroupData[{

Cell["Together[l1 - l1paper[\[Omega]^2, \[Omega]]]", "Input",
 CellChangeTimes->{{3.9998404258290386`*^9, 3.9998404270694427`*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"d71c81e4-aafe-45e2-be2c-b9707e381351"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.9998391127125616`*^9, 3.9998393649854946`*^9, 
  3.9998404602006807`*^9, 3.9999196271906137`*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"83a12116-4912-438d-9bc0-ec5e95501a72"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. The sign of l1 is the sign of g(s)", "Section",ExpressionUUID->"f79a8dcb-58eb-4189-9fa4-45792054a9c3"],

Cell["\<\
P4 and P6 have positive coefficients. P5 has one negative coefficient but is \
positive for s > 3:\
\>", "Text",
 CellChangeTimes->{
  3.9999196652615447`*^9},ExpressionUUID->"3f3e0846-d231-42a6-b435-\
6eb40757f767"],

Cell[CellGroupData[{

Cell["{CoefficientList[P4[s], s], CoefficientList[P6[s], s]}", "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"26e4a143-8b93-4650-a9ac-c4685da09e01"],

