 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"100", ",", "85", ",", "39", ",", "7", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "100", ",", "600", ",", "1245", ",", "950", ",", "441", ",", "108", ",", 
     "16"}], "}"}]}], "}"}]], "Output",
