}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. The three terms of the formula", "Section",ExpressionUUID->"0f3abb0c-2fcf-4583-bc59-71351c49aca8"],

Cell["\<\
h11 = A^-1 B(q, qbar) and h20 = (2 i \[Omega] I - A)^-1 B(q, q). Then G = - 2 \
<p, B(q, h11)> + <p, B(qbar, h20)>, because C(q,q,qbar) is 0.\
\>", "Text",
 CellChangeTimes->{
  3.999840389549529*^9, {3.9998436588833857`*^9, 
   3.9998436746414948`*^9}},ExpressionUUID->"492763d8-3b1b-4e5c-b67f-\
390e9c4fdd50"],

Cell["qb = cc[q];", "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"04959a7f-6d82-42c0-a205-6e27237f06d6"],

Cell[CellGroupData[{

Cell["Chop[N[(qb - Conjugate[q /. \[Omega] -> 27/10]) /. \[Omega] -> \
27/10]]", "Input",
 CellChangeTimes->{{3.9998403948295317`*^9, 3.9998403967275734`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"860ae6c2-df59-48f3-b6df-4cf51d0dde53"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.9998391125414057`*^9, 3.9998393648527603`*^9, 
  3.9998404600693083`*^9, 3.999919627041703*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"9a0df2b7-48ce-4248-802d-793205b1e485"]
}, Open  ]],

Cell["h11 = Together[LinearSolve[AH, B[q, qb]]];", "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"9a5b9407-32ec-4bcb-a65e-79b8ab061a5e"],

Cell["\<\
h20 = Together[LinearSolve[2 I \[Omega] IdentityMatrix[4] - AH, B[q, q]]];\
\>", "Input",
 CellChangeTimes->{3.999840398518422*^9},
 CellLabel->"In[48]:=",ExpressionUUID->"17e9ede9-367a-4137-97f7-6e4ca8d282a5"],

Cell["G = Together[pb . (-2 B[q, h11] + B[qb, h20])];", "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"84af74e7-fd8e-406f-95a5-0df0ac118982"]
}, Open  ]],

