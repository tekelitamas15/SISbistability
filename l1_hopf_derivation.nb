}, Open  ]],

Cell[TextData[{
 "The other factors s + 1, s^2 + 3 s + 6, (s - 3)^4, \[Omega] are positive, \
so sign ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["l", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a80ced5e-b144-4d80-ac6b-e31a57a58cc4"],
 " = sign g(s). g is irreducible over Q, and its coefficients change sign \
exactly once, so  g has exactly one positive root s*; since g(3) < 0 it lies \
in (3, oo):"
}], "Text",
 CellChangeTimes->{
  3.999839178160457*^9, 3.9998404344692683`*^9, {3.9999196686828203`*^9, 
   3.9999196703717833`*^9}},ExpressionUUID->"282ce908-89c2-4bad-a5fc-\
df501666f16c"],

